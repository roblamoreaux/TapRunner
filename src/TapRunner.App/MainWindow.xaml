<Window x:Class="TapRunner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TapRunner.App.Controls"
        Title="TapRunner" Height="620" Width="760" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Test plan selection -->
        <GroupBox Header="Test Plan" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
            <DockPanel Margin="6">
                <Button x:Name="BrowseButton" Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseButton_Click"/>
                <TextBox x:Name="PlanPathText" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
        </GroupBox>

        <!-- Station / operator -->
        <GroupBox Header="Operator" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Operator:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="OperatorNameText" Grid.Column="1" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="StationNameText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic"/>
            </Grid>
        </GroupBox>

        <!-- Parameters -->
        <GroupBox Header="Test Plan Parameters" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ParametersList" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{Binding}" Loaded="ParameterTextBox_Loaded" VerticalContentAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Last step executed -->
        <Border Grid.Row="3" Grid.Column="0" Margin="0,0,0,10" Padding="6,4" BorderBrush="#FFBBBBBB" BorderThickness="1" Background="#FFF5F5F5">
            <TextBlock x:Name="LastStepText" Text="No steps run yet." FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- TUI option -->
        <CheckBox x:Name="UseTuiCheckBox" Grid.Row="4" Grid.Column="0" Content="Run with TUI (text-based interface)" Margin="0,0,0,10"/>

        <!-- Run / Stop / Abort / Exit -->
        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="RunButton" Content="Run" Width="90" Height="32" Margin="0,0,8,0" Click="RunButton_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="90" Height="32" Margin="0,0,8,0" Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="AbortButton" Content="Abort" Width="90" Height="32" Margin="0,0,8,0" Click="AbortButton_Click" IsEnabled="False"/>
            <Button x:Name="ExitButton" Content="Exit" Width="90" Height="32" Margin="0,0,8,0" Click="ExitButton_Click"/>
            <Button x:Name="SettingsButton" Content="Settings..." Width="90" Height="32" Click="SettingsButton_Click"/>
        </StackPanel>

        <!-- Status line -->
        <TextBlock x:Name="StatusMessageText" Grid.Row="6" Grid.Column="0" Foreground="DimGray" TextWrapping="Wrap"/>

        <!-- Status circles -->
        <GroupBox Header="Status" Grid.Row="0" Grid.RowSpan="6" Grid.Column="1">
            <StackPanel Margin="6" VerticalAlignment="Top">
                <controls:StatusCircle x:Name="ReadyCircle" Label="Ready" Margin="0,4"/>
                <controls:StatusCircle x:Name="RunningCircle" Label="Running" Margin="0,4"/>
                <controls:StatusCircle x:Name="PassedCircle" Label="Passed" Margin="0,4"/>
                <controls:StatusCircle x:Name="FailedCircle" Label="Failed" Margin="0,4"/>
                <controls:StatusCircle x:Name="ErrorCircle" Label="Error" Margin="0,4"/>
                <controls:StatusCircle x:Name="AbortedCircle" Label="Aborted" Margin="0,4"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
