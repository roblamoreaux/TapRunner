<Window x:Class="TapRunner.App.FailedStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRunner - Failed / Error Steps" Height="600" Width="820" MinHeight="300" MinWidth="420"
        WindowStartupLocation="CenterOwner" Icon="Assets/TapRunner.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ContentText" Grid.Row="0"
                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Width="80" Height="28" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button Content="Close" Width="80" Height="28" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
