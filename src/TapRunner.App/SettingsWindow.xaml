<Window x:Class="TapRunner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRunner Settings" Height="560" Width="560" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="Assets/TapRunner.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <StackPanel Margin="10">
                    <TextBlock Text="OpenTAP executable (tap.exe):" Margin="0,4,0,2"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseTapExe_Click"/>
                        <TextBox x:Name="TapExecutablePathText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="OpenTAP profile (blank = OpenTAP's own default; TUI mode ignores this - it has no --settings option):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <ComboBox x:Name="ProfileComboBox" IsEditable="True" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Working directory (directory to run OpenTAP in):" Margin="0,10,0,2"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseWorkingDirectory_Click"/>
                        <TextBox x:Name="WorkingDirectoryText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Station name:" Margin="0,10,0,2"/>
                    <TextBox x:Name="StationNameText"/>

                    <TextBlock Text="Log file (opened with the &quot;Open Log&quot; button; the failed/error step log is saved next to it):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseLogFile_Click"/>
                        <TextBox x:Name="LogFilePathText" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <CheckBox x:Name="ClearFailureLogOnRunCheckBox" Margin="0,6,0,0">
                        <TextBlock Text="Clear the failure log at the start of each run (unchecked = keep accumulating across runs)" TextWrapping="Wrap"/>
                    </CheckBox>

                    <DockPanel Margin="0,14,0,4">
                        <Button x:Name="CopyFromCurrentPlanButton" Content="Copy From Current Plan" Padding="6,1" FontSize="11"
                                DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,0,0,0" Click="CopyFromCurrentPlanButton_Click"
                                ToolTip="Copy every parameter currently shown in the main window, with its current value, into the list below."/>
                        <TextBlock Text="Default parameter values (blank = use the TapPlan's own default; a value here always overrides the TapPlan's, serial number fields included):" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DataGrid x:Name="DefaultParametersGrid" Height="180" AutoGenerateColumns="False"
                              CanUserAddRows="True" CanUserDeleteRows="True" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Default Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Status Colors">
                <StackPanel Margin="10">
                    <TextBlock Text="Color = any WPF color name or #RRGGBB hex value. Flash only applies while the circle is fully lit." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid x:Name="ColorsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
