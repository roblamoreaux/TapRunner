<Window x:Class="TapRunner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRunner Settings" Height="660" Width="600" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="Assets/TapRunner.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="OpenTAP executable (tap.exe):" Margin="0,4,0,2"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseTapExe_Click"/>
                        <TextBox x:Name="TapExecutablePathText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="OpenTAP profile (blank = OpenTAP's own default; TUI mode ignores this - it has no --settings option):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <ComboBox x:Name="ProfileComboBox" IsEditable="True" VerticalContentAlignment="Center"/>

                    <TextBlock x:Name="SqliteDatabaseLabel" Text="SQLite results database (saved to OpenTAP's Settings\Results.xml):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button x:Name="BrowseSqliteDatabaseButton" Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseSqliteDatabase_Click"/>
                        <TextBox x:Name="SqliteDatabaseText" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="SqliteDatabaseNote" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                    <TextBlock Text="Working directory (directory to run OpenTAP in):" Margin="0,10,0,2"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseWorkingDirectory_Click"/>
                        <TextBox x:Name="WorkingDirectoryText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Power On plan (run by the Power On button; a bare name is looked for in the working directory, then next to tap.exe):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowsePowerOnPlan_Click"/>
                        <TextBox x:Name="PowerOnPlanText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Power Off plan (run by the Power Off button):" Margin="0,10,0,2"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowsePowerOffPlan_Click"/>
                        <TextBox x:Name="PowerOffPlanText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Station name:" Margin="0,10,0,2"/>
                    <TextBox x:Name="StationNameText"/>

                    <TextBlock Text="TapRunner log file (separate from OpenTAP's log; the failed/error step log is saved next to it):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button Content="Open TapRunner Log" Width="130" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OpenTapRunnerLog_Click"/>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseLogFile_Click"/>
                        <TextBox x:Name="LogFilePathText" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="OpenTAP log file (opened by the main window's &quot;Open Log&quot; button; blank = SessionLogs\Latest.txt next to tap.exe):" Margin="0,10,0,2" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button Content="Browse..." Width="80" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseOpenTapLog_Click"/>
                        <TextBox x:Name="OpenTapLogPathText" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <CheckBox x:Name="ClearFailureLogOnRunCheckBox" Margin="0,6,0,0">
                        <TextBlock Text="Clear the failure log at the start of each run (unchecked = keep accumulating across runs)" TextWrapping="Wrap"/>
                    </CheckBox>

                    <DockPanel Margin="0,14,0,4">
                        <Button x:Name="CopyFromCurrentPlanButton" Content="Copy From Current Plan" Padding="6,1" FontSize="11"
                                DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,0,0,0" Click="CopyFromCurrentPlanButton_Click"
                                ToolTip="Copy every parameter currently shown in the main window, with its current value, into the list below."/>
                        <TextBlock Text="Default parameter values (blank = use the TapPlan's own default; a value here always overrides the TapPlan's, serial number fields included):" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DataGrid x:Name="DefaultParametersGrid" Height="180" AutoGenerateColumns="False"
                              CanUserAddRows="True" CanUserDeleteRows="True" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Default Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Hidden" Binding="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DimGray"
                               Text="Hidden parameters are kept out of the main window's parameter list, but are still passed to the test with their default value here (or the TapPlan's own if left blank)."/>
                    <CheckBox x:Name="ShowHiddenGreyedOutCheckBox" Margin="0,6,0,0">
                        <TextBlock Text="Show hidden parameters greyed out (still editable) instead of hiding them" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Status Colors">
                <StackPanel Margin="10">
                    <TextBlock Text="Color = any WPF color name or #RRGGBB hex value. Flash only applies while the circle is fully lit." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid x:Name="ColorsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
