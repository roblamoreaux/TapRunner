<UserControl x:Class="TapRunner.App.Controls.StatusCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="120">
    <UserControl.Resources>
        <Storyboard x:Key="FlashStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Circle" Storyboard.TargetProperty="Opacity"
                              From="1.0" To="0.25" Duration="0:0:0.5"/>
        </Storyboard>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2">
        <Ellipse x:Name="Circle" Width="22" Height="22" Stroke="Black" StrokeThickness="1"
                 Fill="#FF808080" Margin="2,2,8,2"/>
        <TextBlock x:Name="LabelText" VerticalAlignment="Center" FontSize="13"/>
    </StackPanel>
</UserControl>
